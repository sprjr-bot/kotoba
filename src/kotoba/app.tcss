Screen {
    align: center middle;
}

QueryScreen {
    layout: vertical;
    padding: 1 2;
}

#query {
    width: 60;
}

#status {
    height: 1;
    color: $text-muted;
}

ResultsScreen {
    layout: vertical;
}

#results {
    width: 100%;
    height: 1fr;
}

#footer {
    height: 1;
    color: $text-muted;
    background: $surface;
}

.lists {
    width: 100%;
    height: 1fr;
}

#title {
    height: 1;
}

#hint {
    height: 1;
    color: $text-muted;
}

.help-hidden {
    display: none;
}

.list-dialog {
    width: 50;
    height: auto;
    border: solid $primary;
    padding: 1;
}

.list-dialog #title {
    height: 1;
    margin-bottom: 1;
}

.list-dialog Static {
    width: 100%;
}

.confirm-dialog {
    width: auto;
    height: auto;
    border: solid $error;
    padding: 1;
}
