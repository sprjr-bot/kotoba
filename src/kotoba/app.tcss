Screen {
    align: center middle;
    layout: vertical;
}

QueryScreen {
    layout: vertical;
    padding: 1 2;
}

OnboardingScreen, DownloadProgressScreen, SettingsScreen, LicencesScreen, KanjiScreen {
    layout: vertical;
    padding: 1 2;
}

#query {
    width: 60;
}

#status {
    height: 1;
    color: $text-muted;
}

ResultsScreen {
    layout: vertical;
}

#results {
    width: 100%;
    height: 1fr;
}

#footer {
    height: 1;
    color: $text-muted;
    background: $surface;
}

.lists {
    width: 100%;
    height: 1fr;
}

#title {
    height: auto;
}

#hint {
    height: 1;
    color: $text-muted;
}

.dialog {
    width: 60;
    height: auto;
    border: solid $primary;
    padding: 1;
    align: center middle;
}

.dialog Static {
    width: 100%;
    height: auto;
}

.dialog Vertical {
    width: 100%;
    height: auto;
}

.dialog #title {
    text-align: center;
    text-style: bold;
    margin-bottom: 1;
    width: 100%;
}

.dialog #rows {
    width: 100%;
    height: auto;
}

.dialog #hint {
    width: 100%;
    text-align: center;
    color: $text-muted;
    height: auto;
}

.dialog #attribution {
    width: 100%;
    text-align: center;
    color: $text-muted;
    height: auto;
    margin-top: 1;
}

.list-dialog {
    width: 50;
    height: auto;
    border: solid $primary;
    padding: 1;
    align: center middle;
}

.list-dialog #title {
    text-align: center;
    text-style: bold;
    margin-bottom: 1;
    height: auto;
}

.list-dialog #lists {
    height: auto;
    max-height: 16;
    width: 100%;
}

.list-dialog #hint {
    text-align: center;
    color: $text-muted;
    height: 1;
    margin-top: 1;
}

.list-dialog .selected {
    background: $primary;
    color: $text;
    text-style: bold;
}

.list-dialog .row {
    height: 1;
}

.list-dialog .row:hover {
    background: $primary 20%;
}

.confirm-dialog {
    width: 40;
    height: auto;
    border: solid $error;
    padding: 1;
    align: center middle;
    layout: vertical;
}

#rows {
    height: auto;
    width: 100%;
}
