Screen {
    align: center middle;
}

QueryScreen {
    layout: vertical;
    padding: 1 2;
}

#query {
    width: 60;
}

#status {
    height: 1;
    color: $text-muted;
}

ResultsScreen {
    layout: vertical;
}

#results {
    width: 100%;
    height: 1fr;
}

#footer {
    height: 1;
    color: $text-muted;
    background: $surface;
}

.help-hidden {
    display: none;
}
